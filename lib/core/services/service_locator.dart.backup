import 'package:get_it/get_it.dart';
import '../core/database/database_production.dart';
import '../core/services/dgtl_clinical_service.dart';
import '../core/ai/dgtl_rag_service.dart';
import '../core/ai/embedding_gemma_service.dart';
import '../core/ai/vector_search_service.dart';
import '../core/ai/gemma3n_e2b_service.dart';
import '../services/medication_safety_service.dart';

final GetIt getIt = GetIt.instance;

/// Production Dependency Injection Setup
/// Connects Database + AI/ML/RAG + Backend Services
class DgtlServiceLocator {
  static bool _isInitialized = false;

  /// Initialize all production services - call this once at app startup
  static Future<void> initialize() async {
    if (_isInitialized) return;
    
    print('🚀 Initializing DGTL Healthcare Services...');
    
    try {
      // 1. Core Database (Production)
      getIt.registerLazySingleton<DgtlDatabase>(() => DgtlDatabase());
      print('✅ Database registered');
      
      // 2. AI/ML Services
      getIt.registerLazySingleton<EmbeddingGemmaService>(() => EmbeddingGemmaService());
      getIt.registerLazySingleton<DgtlRagService>(() => DgtlRagService());
      getIt.registerLazySingleton<Gemma3nE2BService>(() => Gemma3nE2BService());
      print('✅ AI/ML services registered (including Gemma-3n-E2B)');
      
      // 3. Specialized Services
      getIt.registerLazySingleton<MedicationSafetyService>(() => MedicationSafetyService());
      print('✅ Medication safety service registered');
      
      // 4. Vector Search (with dependencies)
      getIt.registerLazySingleton<VectorSearchService>(() => VectorSearchService(
        embeddingService: getIt<EmbeddingGemmaService>(),
        database: getIt<DgtlDatabase>(), // Note: This might need AppDatabase instead
      ));
      print('✅ Vector search service registered');
      
      // 5. Main Backend Service (Clinical API)
      getIt.registerLazySingleton<DgtlClinicalService>(() => DgtlClinicalService());
      print('✅ Clinical backend service registered');
      
      // 6. Initialize async services
      await _initializeAsyncServices();
      
      _isInitialized = true;
      print('🎉 DGTL Healthcare Services initialized successfully!');
      
    } catch (e) {
      print('❌ Service initialization failed: $e');
      throw Exception('DGTL service setup failed: $e');
    }
  }
  
  /// Initialize services that require async setup
  static Future<void> _initializeAsyncServices() async {
    print('🔧 Initializing async services...');
    
    try {
      // Initialize AI/ML services
      final embeddingService = getIt<EmbeddingGemmaService>();
      await embeddingService.initialize();
      print('✅ Embedding service initialized');
      
      final ragService = getIt<DgtlRagService>();
      await ragService.initialize();
      print('✅ RAG service initialized');
      
      // Initialize new Gemma-3n-E2B service
      final gemma3nService = getIt<Gemma3nE2BService>();
      await gemma3nService.initialize();
      print('✅ Gemma-3n-E2B service initialized');
      
      final medicationService = getIt<MedicationSafetyService>();
      await medicationService.initialize();
      print('✅ Medication service initialized');
      
      // Initialize main clinical service (this connects everything)
      final clinicalService = getIt<DgtlClinicalService>();
      await clinicalService.initialize();
      print('✅ Clinical service initialized (Database + AI + Backend connected)');
      
    } catch (e) {
      print('⚠️ Some services failed to initialize: $e');
      // Continue anyway - services have fallback modes
    }
  }
  
  /// Get the main clinical backend service
  static DgtlClinicalService get clinicalService => getIt<DgtlClinicalService>();
  
  /// Get the RAG service directly
  static DgtlRagService get ragService => getIt<DgtlRagService>();
  
  /// Get the new Gemma-3n-E2B service
  static Gemma3nE2BService get gemma3nService => getIt<Gemma3nE2BService>();
  
  /// Get the database service
  static DgtlDatabase get database => getIt<DgtlDatabase>();
  
  /// Check if services are ready
  static bool get isReady => _isInitialized;
  
  /// Health check - verify all services are working
  static Future<Map<String, bool>> healthCheck() async {
    final results = <String, bool>{};
    
    try {
      results['database'] = getIt.isRegistered<DgtlDatabase>();
      results['embedding'] = getIt.isRegistered<EmbeddingGemmaService>();
      results['rag'] = getIt.isRegistered<DgtlRagService>();
      results['gemma3n_e2b'] = getIt.isRegistered<Gemma3nE2BService>();
      results['clinical'] = getIt.isRegistered<DgtlClinicalService>();
      results['medication'] = getIt.isRegistered<MedicationSafetyService>();
      results['vector_search'] = getIt.isRegistered<VectorSearchService>();
      
      // Test a simple operation
      if (results['clinical'] == true) {
        final clinical = getIt<DgtlClinicalService>();
        // Could add a simple health check method to DgtlClinicalService
        results['clinical_ready'] = true;
      }
      
    } catch (e) {
      print('❌ Health check failed: $e');
    }
    
    return results;
  }
}
