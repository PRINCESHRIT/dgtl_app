import 'dart:convert';import 'dart:io';
import 'dart:math';

/// Hybrid EmbeddingGemma service supporting both official and fallback modes
/// Official mode: Uses sentence-transformers with google/embeddinggemma-300m  
/// Fallback mode: Semantic embeddings with medical domain knowledge
class HybridEmbeddingService {
  static const String _officialModelId = 'google/embeddinggemma-300m';
  static const int _embeddingDimension = 768; // Official EmbeddingGemma dimension
  static const int _fallbackDimension = 256;  // Fallback dimension for compatibility
  
  bool _isOfficialModelAvailable = false;
  bool _isInitialized = false;
  
  /// Initialize the service and detect available embedding methods
  Future<void> initialize() async {
    try {
      // Check if official model is available (Python + sentence-transformers)
      _isOfficialModelAvailable = await _checkOfficialModelAvailability();
      _isInitialized = true;
      
      if (_isOfficialModelAvailable) {
        _logInfo('Using official EmbeddingGemma 300M model via sentence-transformers');
      } else {
        _logInfo('Using fallback semantic embeddings with medical domain knowledge');
      }
    } catch (e) {
      _logError('Initialization failed: $e');
      _isOfficialModelAvailable = false;
      _isInitialized = true;
    }
  }
  
  /// Check if official EmbeddingGemma model is available
  Future<bool> _checkOfficialModelAvailability() async {
    try {
      // Check if Python is available
      final pythonResult = await Process.run('python3', ['--version']);
      if (pythonResult.exitCode != 0) return false;
      
      // Check if sentence-transformers is installed
      final checkScript = '''
import sys
try:
    from sentence_transformers import SentenceTransformer
    # Try to load the model (this will fail if not authenticated/downloaded)
    model = SentenceTransformer("$_officialModelId")
    print("SUCCESS: Official model available")
    sys.exit(0)
except Exception as e:
    print(f"FALLBACK: {e}")
    sys.exit(1)
''';
      
      final checkResult = await Process.run('python3', ['-c', checkScript]);
      return checkResult.exitCode == 0;
      
    } catch (e) {
      _logError('Official model check failed: $e');
      return false;
    }
  }
  
  /// Generate embeddings using the best available method
  Future<List<double>> generateEmbedding(String text) async {
    if (!_isInitialized) {
      await initialize();
    }
    
    if (_isOfficialModelAvailable) {
      return await _generateOfficialEmbedding(text);
    } else {
      return _generateFallbackEmbedding(text);
    }
  }
  
  /// Generate embedding using official EmbeddingGemma model
  Future<List<double>> _generateOfficialEmbedding(String text) async {
    try {
      final embedScript = '''
import sys
import json
from sentence_transformers import SentenceTransformer

try:
    model = SentenceTransformer("$_officialModelId")
    
    # Apply medical/health prompt template for better embeddings
    prompted_text = "task: search result | query: " + """$text"""
    
    # Generate embedding
    embedding = model.encode([prompted_text])[0]
    
    # Convert to list and output as JSON
    embedding_list = embedding.tolist()
    print(json.dumps(embedding_list))
    sys.exit(0)
    
except Exception as e:
    print(f"ERROR: {e}", file=sys.stderr)
    sys.exit(1)
''';
      
      final result = await Process.run('python3', ['-c', embedScript]);
      
      if (result.exitCode == 0) {
        final dynamic embeddings = await _parseJsonOutput(result.stdout);
        if (embeddings is List) {
          return List<double>.from(embeddings.map((x) => (x as num).toDouble()));
        }
      }
      
      _logError('Official embedding failed: ${result.stderr}');
      return _generateFallbackEmbedding(text);
      
    } catch (e) {
      _logError('Official embedding error: $e');
      return _generateFallbackEmbedding(text);
    }
  }
  
  /// Generate embedding using fallback semantic method
  List<double> _generateFallbackEmbedding(String text) {
    final words = text.toLowerCase()
        .replaceAll(RegExp(r'[^\w\s]'), ' ')
        .split(RegExp(r'\s+'))
        .where((w) => w.isNotEmpty)
        .toList();

    // Medical domain semantic vectors (256D for compatibility)
    final medicalSemantics = <String, List<double>>{
      // Lab test categories
      'blood': _generateGaussianVector(seed: 1001, dimension: _fallbackDimension),
      'glucose': _generateGaussianVector(seed: 1002, dimension: _fallbackDimension),
      'cholesterol': _generateGaussianVector(seed: 1003, dimension: _fallbackDimension),
      'pressure': _generateGaussianVector(seed: 1004, dimension: _fallbackDimension),
      'hemoglobin': _generateGaussianVector(seed: 1005, dimension: _fallbackDimension),
      'creatinine': _generateGaussianVector(seed: 1006, dimension: _fallbackDimension),
      
      // Symptom categories  
      'pain': _generateGaussianVector(seed: 2001, dimension: _fallbackDimension),
      'headache': _generateGaussianVector(seed: 2002, dimension: _fallbackDimension),
      'fatigue': _generateGaussianVector(seed: 2003, dimension: _fallbackDimension),
      'fever': _generateGaussianVector(seed: 2004, dimension: _fallbackDimension),
      'nausea': _generateGaussianVector(seed: 2005, dimension: _fallbackDimension),
      'cough': _generateGaussianVector(seed: 2006, dimension: _fallbackDimension),
      
      // Medical modifiers
      'high': _generateGaussianVector(seed: 3001, dimension: _fallbackDimension),
      'low': _generateGaussianVector(seed: 3002, dimension: _fallbackDimension),
      'normal': _generateGaussianVector(seed: 3003, dimension: _fallbackDimension),
      'abnormal': _generateGaussianVector(seed: 3004, dimension: _fallbackDimension),
      'severe': _generateGaussianVector(seed: 3005, dimension: _fallbackDimension),
      
      // Medical entities
      'patient': _generateGaussianVector(seed: 4001, dimension: _fallbackDimension),
      'test': _generateGaussianVector(seed: 4002, dimension: _fallbackDimension),
      'result': _generateGaussianVector(seed: 4003, dimension: _fallbackDimension),
      'levels': _generateGaussianVector(seed: 4004, dimension: _fallbackDimension),
      'symptoms': _generateGaussianVector(seed: 4005, dimension: _fallbackDimension),
    };

    // Combine semantic vectors based on text content
    final embedding = List.filled(_fallbackDimension, 0.0);
    var foundTerms = 0;

    for (final word in words) {
      if (medicalSemantics.containsKey(word)) {
        final wordVector = medicalSemantics[word]!;
        for (int i = 0; i < _fallbackDimension; i++) {
          embedding[i] += wordVector[i];
        }
        foundTerms++;
      }
    }

    // Add base medical context if no specific terms found
    if (foundTerms == 0) {
      final baseVector = _generateGaussianVector(seed: text.hashCode, dimension: _fallbackDimension);
      for (int i = 0; i < _fallbackDimension; i++) {
        embedding[i] = baseVector[i];
      }
    }

    return _normalizeVector(embedding);
  }
  
  /// Generate batch embeddings
  Future<List<List<double>>> generateBatchEmbeddings(List<String> texts) async {
    if (_isOfficialModelAvailable) {
      return await _generateOfficialBatchEmbeddings(texts);
    } else {
      return texts.map((text) => _generateFallbackEmbedding(text)).toList();
    }
  }
  
  /// Generate batch embeddings using official model
  Future<List<List<double>>> _generateOfficialBatchEmbeddings(List<String> texts) async {
    try {
      final textsJson = texts.map((t) => '"${t.replaceAll('"', '\\"')}"').join(',');
      
      final embedScript = '''
import sys
import json
from sentence_transformers import SentenceTransformer

try:
    model = SentenceTransformer("$_officialModelId")
    
    texts = [$textsJson]
    prompted_texts = ["task: search result | query: " + text for text in texts]
    
    embeddings = model.encode(prompted_texts)
    embeddings_list = [embedding.tolist() for embedding in embeddings]
    
    print(json.dumps(embeddings_list))
    sys.exit(0)
    
except Exception as e:
    print(f"ERROR: {e}", file=sys.stderr)
    sys.exit(1)
''';
      
      final result = await Process.run('python3', ['-c', embedScript]);
      
      if (result.exitCode == 0) {
        final dynamic embeddings = await _parseJsonOutput(result.stdout);
        if (embeddings is List) {
          return embeddings.map<List<double>>((e) => 
            List<double>.from((e as List).map((x) => (x as num).toDouble()))
          ).toList();
        }
      }
      
      _logError('Official batch embedding failed: ${result.stderr}');
      return texts.map((text) => _generateFallbackEmbedding(text)).toList();
      
    } catch (e) {
      _logError('Official batch embedding error: $e');
      return texts.map((text) => _generateFallbackEmbedding(text)).toList();
    }
  }
  
  /// Find most similar texts using embedding comparison
  Future<List<SimilarityResult>> findSimilar(
    String queryText,
    List<String> candidateTexts,
    {int topK = 5}
  ) async {
    final queryEmbedding = await generateEmbedding(queryText);
    final candidateEmbeddings = await generateBatchEmbeddings(candidateTexts);
    
    final results = <SimilarityResult>[];
    for (int i = 0; i < candidateTexts.length; i++) {
      final similarity = cosineSimilarity(queryEmbedding, candidateEmbeddings[i]);
      results.add(SimilarityResult(
        text: candidateTexts[i],
        similarity: similarity,
        index: i,
      ));
    }
    
    results.sort((a, b) => b.similarity.compareTo(a.similarity));
    return results.take(topK).toList();
  }
  
  /// Calculate cosine similarity between two embeddings
  double cosineSimilarity(List<double> a, List<double> b) {
    if (a.length != b.length) return 0.0;
    
    double dotProduct = 0.0;
    double normA = 0.0;
    double normB = 0.0;
    
    for (int i = 0; i < a.length; i++) {
      dotProduct += a[i] * b[i];
      normA += a[i] * a[i];
      normB += b[i] * b[i];
    }
    
    final magnitude = sqrt(normA) * sqrt(normB);
    return magnitude == 0 ? 0.0 : dotProduct / magnitude;
  }
  
  /// Get service status and configuration
  Map<String, dynamic> getStatus() {
    return {
      'isInitialized': _isInitialized,
      'isOfficialModelAvailable': _isOfficialModelAvailable,
      'officialModelId': _officialModelId,
      'embeddingDimension': _isOfficialModelAvailable ? _embeddingDimension : _fallbackDimension,
      'mode': _isOfficialModelAvailable ? 'official' : 'fallback',
    };
  }
  
  // Utility Methods
  
  dynamic _parseJsonOutput(String output) {
    try {
      final lines = output.split('\n').where((line) => line.trim().isNotEmpty).toList();
      final jsonLine = lines.last; // Get the last non-empty line
      return json.decode(jsonLine);
    } catch (e) {
      _logError('JSON parsing failed: $e');
      return null;
    }
  }
  
  List<double> _generateGaussianVector({required int seed, required int dimension}) {
    final seededRandom = Random(seed);
    final vector = <double>[];
    
    for (int i = 0; i < dimension; i += 2) {
      final u1 = seededRandom.nextDouble();
      final u2 = seededRandom.nextDouble();
      
      final z0 = sqrt(-2.0 * log(u1)) * cos(2.0 * pi * u2);
      final z1 = sqrt(-2.0 * log(u1)) * sin(2.0 * pi * u2);
      
      vector.add(z0);
      if (i + 1 < dimension) {
        vector.add(z1);
      }
    }
    
    return vector;
  }
  
  List<double> _normalizeVector(List<double> vector) {
    final magnitude = sqrt(vector.map((x) => x * x).reduce((a, b) => a + b));
    if (magnitude == 0) return vector;
    return vector.map((x) => x / magnitude).toList();
  }
  
  void _logInfo(String message) {
    if (const bool.fromEnvironment('dart.vm.product') == false) {
      print('[HybridEmbedding] ℹ️  $message');
    }
  }
  
  void _logError(String message) {
    if (const bool.fromEnvironment('dart.vm.product') == false) {
      print('[HybridEmbedding] ❌ $message');
    }
  }
  
  void dispose() {
    _isInitialized = false;
    _isOfficialModelAvailable = false;
  }
}

/// Result structure for similarity search
class SimilarityResult {
  final String text;
  final double similarity;
  final int index;

  SimilarityResult({
    required this.text,
    required this.similarity,
    required this.index,
  });

  @override
  String toString() {
    return 'SimilarityResult(text: "${text.substring(0, text.length.clamp(0, 50))}...", '
           'similarity: ${similarity.toStringAsFixed(4)}, index: $index)';
  }
}
